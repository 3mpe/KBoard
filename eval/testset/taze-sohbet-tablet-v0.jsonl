{"id": "taze-tablet-001", "text": "Selam, nasılsın, uzun zamandır konuşamadık.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-005", "text": "İyi akşamlar, müsaitsen biraz konuşalım mı?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-009", "text": "İyiyim, sağ ol, senden ne haber?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-011", "text": "Yarın akşam buluşalım mı, müsait misin?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-015", "text": "Saat yedide meydanda buluşuyoruz, unutma.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-019", "text": "Bu hafta çok yoğunum, haftaya görüşsek olur mu?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-021", "text": "Yoldayım, on dakikaya oradayım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-025", "text": "Şimdi evden çıkıyorum, birazdan gelirim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-029", "text": "Siz başlayın, ben yarım saate yetişirim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-031", "text": "Akşama ne yemek yapayım, canın ne çekiyor?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-035", "text": "Yemek hazır, hadi sofraya gelin.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-039", "text": "Tatlı olarak sütlaç yaptım, sana da ayırdım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-041", "text": "Toplantı saat üçe ertelendi, haberin olsun.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-045", "text": "Bugün mesaiye kalacağım, geç gelirim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-049", "text": "Müşteri teklifi kabul etti, hayırlı olsun.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-051", "text": "Sınav nasıl geçti, soruları yapabildin mi?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-055", "text": "Bütün gece ders çalıştım, hiç uyumadım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-059", "text": "Derse yetişemeyeceğim, yoklama alınırsa haber ver.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-061", "text": "Anneannemi aradın mı, seni soruyordu.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-065", "text": "Kardeşini okuldan almayı unutma lütfen.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-069", "text": "Odanı ne zaman toplayacaksın kızım?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-071", "text": "Markete gidiyorum, bir şey lazım mı?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-075", "text": "Fiyatlar çok artmış, hiçbir şey alamadım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-079", "text": "Bana biraz borç verebilir misin, ay sonu ödeyeceğim?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-081", "text": "Başım çok ağrıyor, biraz uzanacağım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-085", "text": "Dün gece hiç uyuyamadım, çok yorgunum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-089", "text": "Tahlil sonuçları çıktı, her şey normalmiş.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-091", "text": "Hava çok soğuk, kalın giyin.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-095", "text": "Deniz harikaydı, keşke sen de gelseydin.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-099", "text": "Kar yağınca okullar tatil olur mu sence?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-101", "text": "Çok teşekkür ederim, gerçekten çok yardımcı oldun.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-105", "text": "Tebrik ederim, yeni işinde başarılar dilerim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-111", "text": "Seni çok özledim, ne zaman geleceksin?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-115", "text": "İyi ki varsın, seni çok seviyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-121", "text": "Telefonumun şarjı bitmek üzere, sonra yazarım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-125", "text": "Fotoğrafları gruba atar mısın?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-131", "text": "Maçı izledin mi, son dakikada gol yedik.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-135", "text": "Hafta sonu konsere bilet buldum, gelir misin?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-141", "text": "Tamam canım, sorun değil.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
{"id": "taze-tablet-145", "text": "Bence de, çok iyi olur.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["tablet"]}
