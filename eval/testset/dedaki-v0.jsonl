{"id": "dedaki-001", "text": "Ben de gelmek istiyorum.", "input": "Bende gelmek istiyorum.", "category": "kural", "tags": ["kural", "kural_dedaki", "kural_deda"], "note": "bende → ben de", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
