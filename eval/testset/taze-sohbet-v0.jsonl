{"id": "taze-sohbet-002", "text": "Günaydın canım, iyi uyudun mu?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-1"]}
{"id": "taze-sohbet-003", "text": "Merhaba, bugün nasıl hissediyorsun kendini?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-1"]}
{"id": "taze-sohbet-004", "text": "Naber kanka, ne yapıyorsun bu aralar?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-1"]}
{"id": "taze-sohbet-006", "text": "Ne var ne yok, işler nasıl gidiyor?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-1"]}
{"id": "taze-sohbet-007", "text": "Hayırlı sabahlar anne, babam nasıl oldu?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-1"]}
{"id": "taze-sohbet-008", "text": "Uzun zaman oldu, seni çok merak ettim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-1"]}
{"id": "taze-sohbet-010", "text": "Çocuklar nasıl, herkes iyi mi orada?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-1"]}
{"id": "taze-sohbet-012", "text": "Cumartesi günü kahvaltıya gidelim diyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-2"]}
{"id": "taze-sohbet-013", "text": "Hafta sonu bir planın var mı?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-2"]}
{"id": "taze-sohbet-014", "text": "Akşam bize gelsenize, çay içeriz.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-2"]}
{"id": "taze-sohbet-016", "text": "Bugün olmaz ama pazar günü uyar bana.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-2"]}
{"id": "taze-sohbet-017", "text": "Sinemaya gidecektik, hâlâ geliyor musun?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-2"]}
{"id": "taze-sohbet-018", "text": "Kaçta çıkarsın işten, seni alayım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-2"]}
{"id": "taze-sohbet-020", "text": "Nerede buluşacağımızı sen söyle, bana fark etmez.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-2"]}
{"id": "taze-sohbet-022", "text": "Trafik çok kötü, biraz gecikeceğim kusura bakma.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-3"]}
{"id": "taze-sohbet-023", "text": "Otobüsü kaçırdım, bir sonrakini bekliyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-3"]}
{"id": "taze-sohbet-024", "text": "Neredesin, ben kapının önünde bekliyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-3"]}
{"id": "taze-sohbet-026", "text": "Konum atar mısın, yeri bulamadım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-3"]}
{"id": "taze-sohbet-027", "text": "Beş dakika daha bekleyin, hemen geliyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-3"]}
{"id": "taze-sohbet-028", "text": "Metrodan indim, yürüyerek geliyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-3"]}
{"id": "taze-sohbet-030", "text": "Geldim ama seni göremiyorum, hangi taraftasın?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-3"]}
{"id": "taze-sohbet-032", "text": "Acıktım, dışarıdan bir şeyler söyleyelim mi?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-4"]}
{"id": "taze-sohbet-033", "text": "Eve gelirken ekmek alır mısın?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-4"]}
{"id": "taze-sohbet-034", "text": "Annemin yaptığı mantıyı çok özledim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-4"]}
{"id": "taze-sohbet-036", "text": "Ben yedim, sen kendine bir şey hazırla.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-4"]}
{"id": "taze-sohbet-037", "text": "Çorba ocakta, altını kısmayı unutma.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-4"]}
{"id": "taze-sohbet-038", "text": "Öğlen ne yedin, yine tost mu?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-4"]}
{"id": "taze-sohbet-040", "text": "Kahve içmeye gidelim mi yemekten sonra?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-4"]}
{"id": "taze-sohbet-042", "text": "Raporu bitirdim, birazdan sana gönderiyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-5"]}
{"id": "taze-sohbet-043", "text": "Müdür bugün izinli, yarın konuşuruz.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-5"]}
{"id": "taze-sohbet-044", "text": "Sunumu hazırladın mı, bir göz atabilir miyim?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-5"]}
{"id": "taze-sohbet-046", "text": "Dosyayı ortak klasöre yükledim, kontrol eder misin?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-5"]}
{"id": "taze-sohbet-047", "text": "Yarınki görüşmeye sen de katılacak mısın?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-5"]}
{"id": "taze-sohbet-048", "text": "İşten yeni çıktım, çok yorucu bir gündü.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-5"]}
{"id": "taze-sohbet-050", "text": "Pazartesi izin alabilir miyim acaba?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-5"]}
{"id": "taze-sohbet-052", "text": "Ödevi yarına kadar teslim etmemiz gerekiyor.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-6"]}
{"id": "taze-sohbet-053", "text": "Hoca dersi iptal etmiş, boşuna gelme.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-6"]}
{"id": "taze-sohbet-054", "text": "Matematik notlarını bana da atar mısın?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-6"]}
{"id": "taze-sohbet-056", "text": "Kütüphanede çalışıyorum, akşam ararım seni.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-6"]}
{"id": "taze-sohbet-057", "text": "Final haftası başlıyor, çok stresliyim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-6"]}
{"id": "taze-sohbet-058", "text": "Proje grubunda kimler var, biliyor musun?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-6"]}
{"id": "taze-sohbet-060", "text": "Karnen ne zaman veriliyor oğlum?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-6"]}
{"id": "taze-sohbet-062", "text": "Çamaşırları astım, kuruyunca toplar mısın?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-7"]}
{"id": "taze-sohbet-063", "text": "Babam eve geldi mi, telefonu açmıyor.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-7"]}
{"id": "taze-sohbet-064", "text": "Bulaşıkları ben yıkarım, sen dinlen biraz.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-7"]}
{"id": "taze-sohbet-066", "text": "Evi süpürdüm, sıra tozlarda.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-7"]}
{"id": "taze-sohbet-067", "text": "Çöpü çıkarırken kapıyı kilitlemeyi unutma.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-7"]}
{"id": "taze-sohbet-068", "text": "Teyzemler akşam yemeğe geliyor, evi toparlayalım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-7"]}
{"id": "taze-sohbet-070", "text": "Dedemin ilaçlarını eczaneden aldım, merak etmeyin.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-7"]}
{"id": "taze-sohbet-072", "text": "Bu ayakkabı indirime girmiş, alsam mı?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-8"]}
{"id": "taze-sohbet-073", "text": "Kirayı yatırdın mı, ev sahibi sordu.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-8"]}
{"id": "taze-sohbet-074", "text": "Maaş yattı mı, haberin var mı?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-8"]}
{"id": "taze-sohbet-076", "text": "Sana borcumu yarın elden veririm.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-8"]}
{"id": "taze-sohbet-077", "text": "Kargom hâlâ gelmedi, sinir oldum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-8"]}
{"id": "taze-sohbet-078", "text": "Pazardan domates ve biber aldım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-8"]}
{"id": "taze-sohbet-080", "text": "Hangi rengi alayım, mavi mi siyah mı?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-8"]}
{"id": "taze-sohbet-082", "text": "Doktora gittin mi, ne dedi?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-9"]}
{"id": "taze-sohbet-083", "text": "Geçmiş olsun, şimdi daha iyi misin?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-9"]}
{"id": "taze-sohbet-084", "text": "Grip oldum galiba, boğazım yanıyor.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-9"]}
{"id": "taze-sohbet-086", "text": "İlacını içmeyi unutma, sonra yine ateşin çıkar.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-9"]}
{"id": "taze-sohbet-087", "text": "Hastaneden randevu aldım, salı günü gideceğim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-9"]}
{"id": "taze-sohbet-088", "text": "Kendimi hiç iyi hissetmiyorum, bugün gelemeyeceğim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-9"]}
{"id": "taze-sohbet-090", "text": "Midem bulanıyor, yanlış bir şey yedim herhalde.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-9"]}
{"id": "taze-sohbet-092", "text": "Dışarıda yağmur yağıyor, şemsiyeni al.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-10"]}
{"id": "taze-sohbet-093", "text": "Tatile ne zaman çıkıyorsunuz bu yaz?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-10"]}
{"id": "taze-sohbet-094", "text": "Uçak biletlerini aldım, sabah erken kalkacağız.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-10"]}
{"id": "taze-sohbet-096", "text": "Bayramda memlekete gidecek misiniz?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-10"]}
{"id": "taze-sohbet-097", "text": "Yollar buzluymuş, arabayı dikkatli kullan.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-10"]}
{"id": "taze-sohbet-098", "text": "Otelden odayı ayırttım, iki gece kalacağız.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-10"]}
{"id": "taze-sohbet-100", "text": "Valizimi hazırladım, yarın sabah yola çıkıyoruz.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-10"]}
{"id": "taze-sohbet-102", "text": "Kusura bakma, dün seni arayamadım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-11"]}
{"id": "taze-sohbet-103", "text": "Doğum günün kutlu olsun, nice mutlu yıllara.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-11"]}
{"id": "taze-sohbet-104", "text": "Başınız sağ olsun, çok üzüldüm.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-11"]}
{"id": "taze-sohbet-106", "text": "Özür dilerim, öyle demek istememiştim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-11"]}
{"id": "taze-sohbet-107", "text": "Elinize sağlık, yemek çok güzel olmuş.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-11"]}
{"id": "taze-sohbet-108", "text": "Hayırlı olsun, güle güle oturun.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-11"]}
{"id": "taze-sohbet-109", "text": "Allah rahmet eylesin, mekânı cennet olsun.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-11"]}
{"id": "taze-sohbet-110", "text": "İyi yolculuklar, varınca haber ver.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-11"]}
{"id": "taze-sohbet-112", "text": "Bana neden kızdığını anlamıyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-12"]}
{"id": "taze-sohbet-113", "text": "Aramız bozulsun istemiyorum, konuşalım mı?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-12"]}
{"id": "taze-sohbet-114", "text": "Bugün biraz moralim bozuk, kimseyle konuşmak istemiyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-12"]}
{"id": "taze-sohbet-116", "text": "Onunla barıştınız mı, yoksa hâlâ küs müsünüz?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-12"]}
{"id": "taze-sohbet-117", "text": "Sana güveniyorum, bunu sakın unutma.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-12"]}
{"id": "taze-sohbet-118", "text": "Dün söylediklerin beni gerçekten kırdı.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-12"]}
{"id": "taze-sohbet-119", "text": "Yanında olamadığım için çok üzgünüm.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-12"]}
{"id": "taze-sohbet-120", "text": "Sevgilimle ayrıldık, biraz yalnız kalmak istiyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-12"]}
{"id": "taze-sohbet-122", "text": "İnternet yine kesildi, sende de sorun var mı?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-13"]}
{"id": "taze-sohbet-123", "text": "Sesin kesik kesik geliyor, tekrar arar mısın?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-13"]}
{"id": "taze-sohbet-124", "text": "Şifremi unuttum, hesaba giremiyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-13"]}
{"id": "taze-sohbet-126", "text": "Bilgisayar açılmıyor, ne yapacağımı bilmiyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-13"]}
{"id": "taze-sohbet-127", "text": "Mesajın bana ulaşmamış, bir daha gönder.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-13"]}
{"id": "taze-sohbet-128", "text": "Ekranım kırıldı, tamire götürmem lazım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-13"]}
{"id": "taze-sohbet-129", "text": "Uygulamayı güncelledikten sonra sürekli donuyor.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-13"]}
{"id": "taze-sohbet-130", "text": "Burada telefon hiç çekmiyor, eve gidince ararım.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-13"]}
{"id": "taze-sohbet-132", "text": "Yeni bir dizi başladım, kesin izlemelisin.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-14"]}
{"id": "taze-sohbet-133", "text": "Halı sahaya geliyor musun bu akşam?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-14"]}
{"id": "taze-sohbet-134", "text": "Filmin sonu hiç beklediğim gibi bitmedi.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-14"]}
{"id": "taze-sohbet-136", "text": "Spor salonuna yazıldım, yarın başlıyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-14"]}
{"id": "taze-sohbet-137", "text": "Bu şarkıyı dinle, çok seveceksin.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-14"]}
{"id": "taze-sohbet-138", "text": "Kitabı bitirdim, istersen sana vereyim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-14"]}
{"id": "taze-sohbet-139", "text": "Akşam tavla oynayalım mı, çayları ben demlerim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-14"]}
{"id": "taze-sohbet-140", "text": "Takım bu sezon çok kötü oynuyor abi.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-14"]}
{"id": "taze-sohbet-142", "text": "Olur tabii, neden olmasın?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-15"]}
{"id": "taze-sohbet-143", "text": "Yok ya, ciddi misin?", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-15"]}
{"id": "taze-sohbet-144", "text": "Aynen öyle, sana katılıyorum.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-15"]}
{"id": "taze-sohbet-146", "text": "Tabii ki, ne demek.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-15"]}
{"id": "taze-sohbet-147", "text": "Bilmiyorum ki, bir düşüneyim.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-15"]}
{"id": "taze-sohbet-148", "text": "Vallahi çok şaşırdım buna.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-15"]}
{"id": "taze-sohbet-149", "text": "Peki, öyle yapalım o zaman.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-15"]}
{"id": "taze-sohbet-150", "text": "Haklısın, ben de öyle düşünmüştüm.", "category": "sohbet", "source": "sentetik", "license": "CC0-1.0", "tags": ["konu-15"]}
