{"id": "kisisel-deniz-ogrenci-01", "text": "Günaydın Ecoş, bugün derse geliyor musun?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ecoş"]}
{"id": "kisisel-deniz-ogrenci-02", "text": "Ben Bornova'dayım, kütüphanede yer tuttum.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-03", "text": "Barışko yine derse geç kaldı, hoca çok kızdı.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Barışko"]}
{"id": "kisisel-deniz-ogrenci-04", "text": "Vize haftası başladı ama hiç çalışmadım.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-05", "text": "Akşam Alsancak'ta buluşalım mı?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-06", "text": "Kampüsbüfe'de tost yiyoruz, sen de gel.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Kampüsbüfe'de"]}
{"id": "kisisel-deniz-ogrenci-07", "text": "Kütüphanede yer yok, Kampüsbüfe'ye geçiyoruz.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Kampüsbüfe'ye"]}
{"id": "kisisel-deniz-ogrenci-08", "text": "Ecoş notları bana atar mısın?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ecoş"]}
{"id": "kisisel-deniz-ogrenci-09", "text": "Barışko ile kordonda yürüyoruz, hava çok güzel.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Barışko"]}
{"id": "kisisel-deniz-ogrenci-10", "text": "Yarın vize var, bu gece kütüphanede kalacağım.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-11", "text": "Annem aradı, hafta sonu eve gelmemi istiyor.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-12", "text": "Derse yetişemedim, otobüs yine gecikti.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-13", "text": "Akşam kordonda buluşalım mı, Barışko da gelecek.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Barışko"]}
{"id": "kisisel-deniz-ogrenci-14", "text": "Ecoş sen hangi saatte çıkıyorsun?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ecoş"]}
{"id": "kisisel-deniz-ogrenci-15", "text": "Kampüsbüfe kapalıymış, başka yere gidelim.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Kampüsbüfe"]}
{"id": "kisisel-deniz-ogrenci-16", "text": "Vize haftası bitince Alsancak'ta kutlama yapalım.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-17", "text": "Bugün de kütüphanedeyim, notları birlikte çalışalım mı?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-18", "text": "Otobüs yine gecikti, derse biraz geç kalacağım.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-19", "text": "Barışko arabayla gelecekmiş, bizi de alır.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Barışko"]}
{"id": "kisisel-deniz-ogrenci-20", "text": "Hocanın sunumunu kim yapacak, sen mi Ecoş?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ecoş"]}
{"id": "kisisel-deniz-ogrenci-21", "text": "Hafta sonu eve gidiyorum, annem çok özlemiş.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-22", "text": "Kordonda oturuyoruz, Ecoş sen neredesin?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ecoş"]}
{"id": "kisisel-deniz-ogrenci-23", "text": "Yarınki vize için notları atar mısın?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-24", "text": "Kampüsbüfe'de sıra çok uzun, bekliyoruz.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Kampüsbüfe'de"]}
{"id": "kisisel-deniz-ogrenci-25", "text": "Bornova'da yeni bir kafe açılmış, akşam gidelim mi?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-26", "text": "Barışko yine uyuyakalmış, derse gelmedi.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Barışko"]}
{"id": "kisisel-deniz-ogrenci-27", "text": "Bu gece kütüphanede sabahlayacağız galiba.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-28", "text": "Akşam Alsancak'ta yemek yiyelim mi?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-29", "text": "Ecoş vize nasıl geçti?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ecoş"]}
{"id": "kisisel-deniz-ogrenci-30", "text": "Benimki kötü geçti, hiç çalışmamıştım zaten.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-31", "text": "Kampüsbüfe'de buluşalım, sonra derse gireriz.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Kampüsbüfe'de"]}
{"id": "kisisel-deniz-ogrenci-32", "text": "Annem aradı, bayramda eve gelmemi istiyor.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-33", "text": "Kordonda bisiklet sürelim mi hafta sonu?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-34", "text": "Barışko ile Bornova'da kahve içiyoruz.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Barışko"]}
{"id": "kisisel-deniz-ogrenci-35", "text": "Hocanın notları sistemde yok, sende var mı?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-36", "text": "Otobüs gelmedi, derse yetişemeyeceğim.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-37", "text": "Vize haftası bitti, akşam Alsancak'ta buluşalım mı?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-deniz-ogrenci-38", "text": "Ecoş yarın kütüphanede yer tutar mısın?", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ecoş"]}
{"id": "kisisel-deniz-ogrenci-39", "text": "Kampüsbüfe'nin tostları yine çok güzeldi.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Kampüsbüfe'nin"]}
{"id": "kisisel-deniz-ogrenci-40", "text": "Barışko sen de akşam kordona gel.", "category": "kisisel", "user": "deniz-ogrenci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Barışko"]}
{"id": "kisisel-mehmet-muhendis-01", "text": "Sevgi, toplantıdayım, sonra ararım.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-02", "text": "Akşam eve geçerken ekmek alırım.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-03", "text": "Şantiyede beton dökülüyor, geç kalabilirim.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-04", "text": "Elifçik okuldan geldi mi?", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Elifçik"]}
{"id": "kisisel-mehmet-muhendis-05", "text": "Betonsan'dan malzeme hâlâ gelmedi.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Betonsan'dan"]}
{"id": "kisisel-mehmet-muhendis-06", "text": "Canoş ödevini yaptı mı?", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Canoş"]}
{"id": "kisisel-mehmet-muhendis-07", "text": "Toplantıdayım, birazdan ararım seni.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-08", "text": "Kızılay'da trafik çok yoğun, biraz gecikeceğim.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-09", "text": "Akşam eve geçerken bir şey lazım mı?", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-10", "text": "Elifçik'e söyle, hafta sonu sinemaya gideriz.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Elifçik'e"]}
{"id": "kisisel-mehmet-muhendis-11", "text": "Betonsan'la toplantı uzadı, yemeğe yetişemem.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Betonsan'la"]}
{"id": "kisisel-mehmet-muhendis-12", "text": "Şantiyede işler yolunda, merak etme.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-13", "text": "Canoş maç izlemek istiyorsa birlikte izleriz.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Canoş"]}
{"id": "kisisel-mehmet-muhendis-14", "text": "Sevgi annenleri bu akşam yemeğe çağıralım mı?", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-15", "text": "Toplantıdayım, akşam konuşuruz.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-16", "text": "Çankaya'daki şantiyeye geçiyorum.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-17", "text": "Akşam eve geçerken ekmek ve süt alırım.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-18", "text": "Elifçik bugün okulda ne yaptı?", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Elifçik"]}
{"id": "kisisel-mehmet-muhendis-19", "text": "Betonsan yine fatura göndermiş, kontrol eder misin?", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Betonsan"]}
{"id": "kisisel-mehmet-muhendis-20", "text": "Kızılay'da bir işim var, sonra eve geçerim.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-21", "text": "Canoş'un veli toplantısı ne zaman?", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Canoş'un"]}
{"id": "kisisel-mehmet-muhendis-22", "text": "Şantiyede beton dökülüyor, telefonum sessizde.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-23", "text": "Sevgi hafta sonu Elifçik ve Canoş ile pikniğe gidelim.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Elifçik", "Canoş"]}
{"id": "kisisel-mehmet-muhendis-24", "text": "Toplantıdayım, birazdan dönerim.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-25", "text": "Betonsan'dan Hakan aradı, malzeme yarın geliyormuş.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Betonsan'dan"]}
{"id": "kisisel-mehmet-muhendis-26", "text": "Akşam eve geçerken eczaneye uğrarım.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-27", "text": "Elifçik'in ateşi düştü mü?", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Elifçik'in"]}
{"id": "kisisel-mehmet-muhendis-28", "text": "Çankaya'daki şantiye bitmek üzere.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-29", "text": "Canoş'a söyle, akşam birlikte ödev yaparız.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Canoş'a"]}
{"id": "kisisel-mehmet-muhendis-30", "text": "Kızılay'da trafik yine çok yoğun.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-31", "text": "Toplantıdayım, sonra ararım canım.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-32", "text": "Şantiyede işler uzadı, yemeği beklemeyin.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-33", "text": "Betonsan ile anlaştık, işler hızlanacak.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Betonsan"]}
{"id": "kisisel-mehmet-muhendis-34", "text": "Elifçik'e çok selam söyle.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Elifçik'e"]}
{"id": "kisisel-mehmet-muhendis-35", "text": "Akşam eve geçerken ekmek alırım, başka bir şey var mı?", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-36", "text": "Sevgi annenler hafta sonu geliyor mu?", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-37", "text": "Canoş maçı kazanmışlar, çok sevinmiş.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Canoş"]}
{"id": "kisisel-mehmet-muhendis-38", "text": "Çankaya'daki şantiyede denetim var bugün.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-39", "text": "Toplantıdayım, akşam eve geçerken ararım.", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-mehmet-muhendis-40", "text": "Elifçik ve Canoş uyudu mu?", "category": "kisisel", "user": "mehmet-muhendis", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Elifçik", "Canoş"]}
{"id": "kisisel-zeynep-hemsire-01", "text": "Nöbetten çıktım, eve gidiyorum.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-02", "text": "Gece nöbeti çok yoğun geçti, çok yorgunum.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-03", "text": "Handoş servise kahve getirir misin?", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Handoş"]}
{"id": "kisisel-zeynep-hemsire-04", "text": "Karamelo'ya mama verdin mi?", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Karamelo'ya"]}
{"id": "kisisel-zeynep-hemsire-05", "text": "Kadıköy'de buluşalım mı akşam?", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-06", "text": "Nöbetten çıkınca Moda'da kahvaltı yapalım.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-07", "text": "Kaan Bey vizitte bizi bekliyor.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-08", "text": "Handoş bu hafta nöbetleri değiştirelim mi?", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Handoş"]}
{"id": "kisisel-zeynep-hemsire-09", "text": "Çok yorgunum, eve gidip uyuyacağım.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-10", "text": "Karamelo yine koltuğu tırmalamış.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Karamelo"]}
{"id": "kisisel-zeynep-hemsire-11", "text": "Gece nöbeti bitti, Kadıköy'e geçiyorum.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-12", "text": "Serviste hasta çok, akşam yemeğe yetişemem.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-13", "text": "Annem aradı, hafta sonu bize geliyormuş.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-14", "text": "Nöbetten çıktım, Moda'da sahilde yürüyorum.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-15", "text": "Handoş sen de gelsene kahvaltıya.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Handoş"]}
{"id": "kisisel-zeynep-hemsire-16", "text": "Karamelo'yu veterinere götürmem lazım.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Karamelo'yu"]}
{"id": "kisisel-zeynep-hemsire-17", "text": "Kaan Bey yarın ameliyata giriyormuş.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-18", "text": "Çok yorgunum ama akşam Kadıköy'de buluşabiliriz.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-19", "text": "Gece nöbeti yine bana kaldı.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-20", "text": "Handoş kahve molası verelim mi?", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Handoş"]}
{"id": "kisisel-zeynep-hemsire-21", "text": "Karamelo bütün gece uyutmadı.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Karamelo"]}
{"id": "kisisel-zeynep-hemsire-22", "text": "Nöbetten çıkınca annemi arayacağım.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-23", "text": "Moda'da yeni bir yer açılmış, kahvaltıya gidelim.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-24", "text": "Serviste bugün çok sakin.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-25", "text": "Kaan Bey vizitte yine çok soru sordu.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-26", "text": "Handoş nöbet listesi çıktı mı?", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Handoş"]}
{"id": "kisisel-zeynep-hemsire-27", "text": "Gece nöbetinden sonra hiç enerjim kalmadı.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-28", "text": "Karamelo'ya mama almayı unutma.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Karamelo'ya"]}
{"id": "kisisel-zeynep-hemsire-29", "text": "Kadıköy'de vapura yetiştim, eve geliyorum.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-30", "text": "Nöbetten çıktım, çok yorgunum, sonra konuşuruz.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-31", "text": "Annem hafta sonu Karamelo'ya bakacak.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Karamelo'ya"]}
{"id": "kisisel-zeynep-hemsire-32", "text": "Handoş seninle aynı nöbetteyiz bu hafta.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Handoş"]}
{"id": "kisisel-zeynep-hemsire-33", "text": "Moda'da kahvaltı yapalım mı pazar günü?", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-34", "text": "Kaan Bey bizi tebrik etti, çok sevindim.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-35", "text": "Gece nöbeti başlamadan Kadıköy'de yemek yiyelim.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-36", "text": "Karamelo veterinerde, aşısı yapıldı.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Karamelo"]}
{"id": "kisisel-zeynep-hemsire-37", "text": "Serviste yeni hasta geldi, sonra ararım.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-zeynep-hemsire-38", "text": "Handoş akşam Kadıköy'e gelecek misin?", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Handoş"]}
{"id": "kisisel-zeynep-hemsire-39", "text": "Nöbetten çıktım, eve gidiyorum, Karamelo bekliyor.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Karamelo"]}
{"id": "kisisel-zeynep-hemsire-40", "text": "Çok yorgunum ama mutluyum, bugün iyi geçti.", "category": "kisisel", "user": "zeynep-hemsire", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-01", "text": "Günaydın ekip, bugün sprint toplantısı saat onda.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-02", "text": "Selinoş deploy tamamlandı mı?", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Selinoş"]}
{"id": "kisisel-emre-yazilimci-03", "text": "Kodbahçe'de yeni projeye başlıyoruz.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Kodbahçe'de"]}
{"id": "kisisel-emre-yazilimci-04", "text": "Onur kodu inceledin mi?", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-05", "text": "Bugün evden çalışıyorum, internet biraz yavaş.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-06", "text": "Sprint toplantısı yarına ertelendi.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-07", "text": "Beşiktaş'ta bir kafede çalışıyorum.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-08", "text": "Selinoş testler geçti, birleştirebilirsin.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Selinoş"]}
{"id": "kisisel-emre-yazilimci-09", "text": "Deploy sonrası hata çıktı, bakıyorum.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-10", "text": "Kodbahçe ofisine yarın geliyorum.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Kodbahçe"]}
{"id": "kisisel-emre-yazilimci-11", "text": "Onur ile birlikte hatayı çözdük.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-12", "text": "Bugün evden çalışıyorum, toplantıya bağlantıdan katılırım.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-13", "text": "Selinoş öğle yemeğine çıkalım mı?", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Selinoş"]}
{"id": "kisisel-emre-yazilimci-14", "text": "Sprint toplantısında yeni görevleri dağıttık.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-15", "text": "Beşiktaş'ta öğle yemeği yiyelim mi?", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-16", "text": "Deploy bu akşam yapılacak, herkes hazır olsun.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-17", "text": "Kodbahçe'nin yeni sitesi yayında.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Kodbahçe'nin"]}
{"id": "kisisel-emre-yazilimci-18", "text": "Onur kodu inceledi, birkaç düzeltme istedi.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-19", "text": "Selinoş bugün ofiste misin?", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Selinoş"]}
{"id": "kisisel-emre-yazilimci-20", "text": "Bugün evden çalışıyorum, akşam koşuya çıkarız.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-21", "text": "Sprint toplantısı uzadı, sonra yazarım.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-22", "text": "Testler yine kırıldı, Onur bakabilir misin?", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-23", "text": "Kodbahçe ekibiyle akşam yemeği var.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Kodbahçe"]}
{"id": "kisisel-emre-yazilimci-24", "text": "Beşiktaş'taki kafede internet çok iyi.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-25", "text": "Selinoş deploy için onay verdin mi?", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Selinoş"]}
{"id": "kisisel-emre-yazilimci-26", "text": "Bugün evden çalışıyorum, kargo bekliyorum.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-27", "text": "Sprint toplantısında demo yapacağım.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-28", "text": "Onur ile Beşiktaş'ta buluşuyoruz.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-29", "text": "Deploy sorunsuz geçti, ellerinize sağlık.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-30", "text": "Kodbahçe'de bu hafta çok iş var.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Kodbahçe'de"]}
{"id": "kisisel-emre-yazilimci-31", "text": "Selinoş yarın izinli misin?", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Selinoş"]}
{"id": "kisisel-emre-yazilimci-32", "text": "Testler geçti, kodu birleştirdim.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-33", "text": "Bugün evden çalışıyorum, toplantı linkini atar mısın?", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-34", "text": "Sprint toplantısı öncesi kahve içelim.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-35", "text": "Onur kodu inceledin mi, onay bekliyorum.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-36", "text": "Beşiktaş'ta maç var, erken çıkalım.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-37", "text": "Kodbahçe'nin yıl sonu partisi cuma akşamı.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Kodbahçe'nin"]}
{"id": "kisisel-emre-yazilimci-38", "text": "Selinoş sunum hazır mı?", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Selinoş"]}
{"id": "kisisel-emre-yazilimci-39", "text": "Deploy sonrası her şey yolunda.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-emre-yazilimci-40", "text": "Bugün evden çalışıyorum, akşam görüşürüz.", "category": "kisisel", "user": "emre-yazilimci", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-01", "text": "Gülcüğüm akşama dolma yaptım, gelin yiyelim.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Gülcüğüm"]}
{"id": "kisisel-ayse-emekli-02", "text": "Pazara gidiyorum, bir şey lazım mı?", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-03", "text": "Ardoş okula başladı mı?", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ardoş"]}
{"id": "kisisel-ayse-emekli-04", "text": "Fatma Hanım bugün bize çaya geliyor.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-05", "text": "Allah razı olsun kızım, çok teşekkür ederim.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-06", "text": "Pazardan taze domates aldım.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-07", "text": "Ardoş'a kazak ördüm, hafta sonu getiririm.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ardoş'a"]}
{"id": "kisisel-ayse-emekli-08", "text": "Gülcüğüm ilaçlarımı aldın mı?", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Gülcüğüm"]}
{"id": "kisisel-ayse-emekli-09", "text": "Bursa'da hava çok soğuk bugün.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-10", "text": "Fatma Hanım ile pazara gidiyoruz.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-11", "text": "Akşama dolma yaptım, Ardoş da sever.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ardoş"]}
{"id": "kisisel-ayse-emekli-12", "text": "Allah razı olsun, ellerine sağlık.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-13", "text": "Gülcüğüm hafta sonu Bursa'ya gelecek misiniz?", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Gülcüğüm"]}
{"id": "kisisel-ayse-emekli-14", "text": "Pazara gidiyorum, sana da meyve alırım.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-15", "text": "Ardoş telefonda çok güzel konuştu.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ardoş"]}
{"id": "kisisel-ayse-emekli-16", "text": "Fatma Hanım'ın torunu doğmuş, çok sevindik.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-17", "text": "Akşama mantı yaptım, gelin yiyelim.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-18", "text": "Gülcüğüm doktor randevum ne zaman?", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Gülcüğüm"]}
{"id": "kisisel-ayse-emekli-19", "text": "Allah razı olsun oğlum, sağ ol.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-20", "text": "Pazardan dönerken fırına uğradım.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-21", "text": "Ardoş'u çok özledim, ne zaman geleceksiniz?", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ardoş'u"]}
{"id": "kisisel-ayse-emekli-22", "text": "Bursa'da kar yağıyor, dışarı çıkmadım.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-23", "text": "Fatma Hanım bugün bize geldi, çay içtik.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-24", "text": "Gülcüğüm akşama dolma yaptım, sen de gel.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Gülcüğüm"]}
{"id": "kisisel-ayse-emekli-25", "text": "Pazara gidiyorum, Fatma Hanım da geliyor.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-26", "text": "Ardoş'a söyle, babaannesi onu çok seviyor.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ardoş'a"]}
{"id": "kisisel-ayse-emekli-27", "text": "Allah razı olsun, çok yardımcı oldun.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-28", "text": "Akşama börek yaptım, Ardoş'un en sevdiği.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ardoş'un"]}
{"id": "kisisel-ayse-emekli-29", "text": "Gülcüğüm ilaçlarım bitti, eczaneye gider misin?", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Gülcüğüm"]}
{"id": "kisisel-ayse-emekli-30", "text": "Bursa'ya ne zaman geleceksiniz?", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-31", "text": "Pazardan taze fasulye aldım, akşama pişireceğim.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-32", "text": "Fatma Hanım ile camiye gidiyoruz.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-33", "text": "Ardoş karnesini aldı mı?", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ardoş"]}
{"id": "kisisel-ayse-emekli-34", "text": "Allah razı olsun kızım, ellerine sağlık.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-35", "text": "Gülcüğüm hafta sonu Ardoş'u bana getir.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Gülcüğüm", "Ardoş'u"]}
{"id": "kisisel-ayse-emekli-36", "text": "Akşama dolma yaptım, Fatma Hanım'a da götürdüm.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-37", "text": "Pazara gidiyorum, dönünce ararım.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-38", "text": "Bursa'da hava ısındı, bahçede oturuyorum.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ayse-emekli-39", "text": "Ardoş'un doğum günü yaklaşıyor, hediye aldım.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Ardoş'un"]}
{"id": "kisisel-ayse-emekli-40", "text": "Gülcüğüm Allah razı olsun, iyi ki varsın.", "category": "kisisel", "user": "ayse-emekli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Gülcüğüm"]}
{"id": "kisisel-kerem-halisaha-01", "text": "Bu akşam maç var, kadro tamam mı?", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-02", "text": "Tolgiş sen kaleye geçer misin?", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tolgiş"]}
{"id": "kisisel-kerem-halisaha-03", "text": "Halı saha saat dokuzda, geç kalmayın.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-04", "text": "Serko topu sen getir.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Serko"]}
{"id": "kisisel-kerem-halisaha-05", "text": "Maç kaçta başlıyor?", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-06", "text": "Maltepe'deki halı sahayı ayırttım.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-07", "text": "Tolgiş yine gelmeyecekmiş, yerine biri lazım.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tolgiş"]}
{"id": "kisisel-kerem-halisaha-08", "text": "Kadro tamam, herkes saat dokuzda orada olsun.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-09", "text": "Serko dün akşamki maçı izledin mi?", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Serko"]}
{"id": "kisisel-kerem-halisaha-10", "text": "Bu akşam maç var, eve geç gelirim.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-11", "text": "Halı saha parasını kim topluyor?", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-12", "text": "Tolgiş ile Maltepe'de buluşuyoruz.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tolgiş"]}
{"id": "kisisel-kerem-halisaha-13", "text": "Maç bitince bir şeyler yiyelim mi?", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-14", "text": "Serko yine iki gol attı, efsane oynadı.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Serko"]}
{"id": "kisisel-kerem-halisaha-15", "text": "Kadro tamam mı, Tolgiş geliyor mu?", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tolgiş"]}
{"id": "kisisel-kerem-halisaha-16", "text": "Halı saha bu hafta perşembe.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-17", "text": "Bu akşam maç var, birlikte izleyelim.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-18", "text": "Maltepe'deki sahada ışıklar yanmıyormuş.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-19", "text": "Tolgiş kaleye geçerse kazanırız.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tolgiş"]}
{"id": "kisisel-kerem-halisaha-20", "text": "Serko topu unutma.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Serko"]}
{"id": "kisisel-kerem-halisaha-21", "text": "Maç kaçta, yine dokuzda mı?", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-22", "text": "Halı saha sonrası çay içelim.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-23", "text": "Kadro tamam, yedek de var.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-24", "text": "Tolgiş sakatlanmış, bu hafta oynayamaz.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tolgiş"]}
{"id": "kisisel-kerem-halisaha-25", "text": "Bu akşam maç var ama işten geç çıkacağım.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-26", "text": "Serko ile Maltepe'de kahve içiyoruz.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Serko"]}
{"id": "kisisel-kerem-halisaha-27", "text": "Halı saha parasını ben topladım.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-28", "text": "Maç çok zevkliydi, haftaya yine yapalım.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-29", "text": "Tolgiş iyileşti mi, gelecek mi?", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tolgiş"]}
{"id": "kisisel-kerem-halisaha-30", "text": "Kadro tamam mı, eksik var mı?", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-31", "text": "Bu akşam maç var, kim geliyor?", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-32", "text": "Serko kaleye geçer misin bu sefer?", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Serko"]}
{"id": "kisisel-kerem-halisaha-33", "text": "Maltepe'deki halı sahaya yarım saat erken gelin.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-34", "text": "Maç kaçta bitiyor, sonra yemeğe gidelim.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-35", "text": "Tolgiş yine son dakika golü attı.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tolgiş"]}
{"id": "kisisel-kerem-halisaha-36", "text": "Halı saha saat ona kaydı.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-37", "text": "Kadro tamam, Serko da geliyor.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Serko"]}
{"id": "kisisel-kerem-halisaha-38", "text": "Bu akşam maç var, eşofmanını unutma.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-kerem-halisaha-39", "text": "Tolgiş ile Serko aynı takımda olmasın.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tolgiş", "Serko"]}
{"id": "kisisel-kerem-halisaha-40", "text": "Maç bitti, kazandık, herkese teşekkürler.", "category": "kisisel", "user": "kerem-halisaha", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-01", "text": "Burcuş sabah fırını sen açar mısın?", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Burcuş"]}
{"id": "kisisel-selin-pastane-02", "text": "Pasta siparişi saat beşte hazır olacak.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-03", "text": "Pastaneliz'e yeni masalar geldi.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Pastaneliz'e"]}
{"id": "kisisel-selin-pastane-04", "text": "Hakan Bey un siparişini getirdi mi?", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-05", "text": "Teslimat saat kaçta, müşteri soruyor.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-06", "text": "Sipariş hazır, gelip alabilirsiniz.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-07", "text": "Burcuş vitrine kurabiyeleri dizer misin?", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Burcuş"]}
{"id": "kisisel-selin-pastane-08", "text": "Eskişehir'de bugün çok yoğunuz.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-09", "text": "Pastaneliz'in sayfasına yeni fotoğraf ekledim.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Pastaneliz'in"]}
{"id": "kisisel-selin-pastane-10", "text": "Pasta siparişi için kapora aldık mı?", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-11", "text": "Hakan Bey yarın sabah tereyağı getirecek.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-12", "text": "Sipariş hazır, kuryeyi bekliyoruz.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-13", "text": "Burcuş bugün erken çıkabilirsin.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Burcuş"]}
{"id": "kisisel-selin-pastane-14", "text": "Teslimat saat kaçta olsun istersiniz?", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-15", "text": "Pastaneliz'de bu hafta kampanya var.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Pastaneliz'de"]}
{"id": "kisisel-selin-pastane-16", "text": "Doğum günü pastası siparişi aldık.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-17", "text": "Hakan Bey'e ödemeyi yaptım.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-18", "text": "Burcuş kasayı kapattın mı?", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Burcuş"]}
{"id": "kisisel-selin-pastane-19", "text": "Pasta siparişi iptal oldu, haberin olsun.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-20", "text": "Eskişehir'de yeni bir şube açmayı düşünüyorum.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-21", "text": "Sipariş hazır, adrese çıkıyoruz.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-22", "text": "Pastaneliz'e bugün çok müşteri geldi.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Pastaneliz'e"]}
{"id": "kisisel-selin-pastane-23", "text": "Teslimat saat kaçta yapılacak, not alayım.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-24", "text": "Burcuş yarın izin istiyor musun?", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Burcuş"]}
{"id": "kisisel-selin-pastane-25", "text": "Hakan Bey un fiyatına zam yapmış.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-26", "text": "Pasta siparişi için çikolatalı mı istediler?", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-27", "text": "Sipariş hazır, müşteriye mesaj attım.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-28", "text": "Pastaneliz'in vitrini çok güzel oldu.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Pastaneliz'in"]}
{"id": "kisisel-selin-pastane-29", "text": "Burcuş kurabiyeler fırından çıktı mı?", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Burcuş"]}
{"id": "kisisel-selin-pastane-30", "text": "Eskişehir'de hava güzel, bahçe masalarını açalım.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-31", "text": "Teslimat saat kaçta, kurye soruyor.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-32", "text": "Hakan Bey bu hafta gelmeyecekmiş.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-33", "text": "Pasta siparişi saat altıda teslim edilecek.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-34", "text": "Pastaneliz'e yeni eleman alalım mı?", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Pastaneliz'e"]}
{"id": "kisisel-selin-pastane-35", "text": "Burcuş sen olmasan ne yapardım.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Burcuş"]}
{"id": "kisisel-selin-pastane-36", "text": "Sipariş hazır, paketlemeyi sen yapar mısın?", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-37", "text": "Doğum günü pastası çok beğenilmiş.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-38", "text": "Teslimat saat kaçta olursa uygun?", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-39", "text": "Hakan Bey'den yarın şeker de alalım.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-selin-pastane-40", "text": "Pastaneliz bugün erken kapanacak.", "category": "kisisel", "user": "selin-pastane", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Pastaneliz"]}
{"id": "kisisel-ali-uzak-01", "text": "Günaydın Meliş, uyandın mı?", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Meliş"]}
{"id": "kisisel-ali-uzak-02", "text": "Seni çok özledim, ne zaman geliyorsun?", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-03", "text": "Akşam görüntülü konuşalım mı?", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-04", "text": "Uçağım rötar yaptı, havalimanında bekliyorum.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-05", "text": "Berlin'de hava nasıl?", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-06", "text": "Tontişim bugün işte nasıldı?", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tontişim"]}
{"id": "kisisel-ali-uzak-07", "text": "Sabiha Gökçen'e indim, eve geçiyorum.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-08", "text": "Seni çok özledim Meliş.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Meliş"]}
{"id": "kisisel-ali-uzak-09", "text": "Akşam görüntülü konuşalım, saat dokuzda uygun mu?", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-10", "text": "Berlin'e bilet baktım, ay sonu gelebilirim.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-11", "text": "Tontişim yemek yedin mi?", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tontişim"]}
{"id": "kisisel-ali-uzak-12", "text": "Uçağım rötar yaptı, iki saat gecikecek.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-13", "text": "Meliş bugün annemle konuştum, sana selam söyledi.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Meliş"]}
{"id": "kisisel-ali-uzak-14", "text": "Seni çok özledim, bu hafta çok uzun geçti.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-15", "text": "Berlin'de kar yağıyormuş, sıkı giyin.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-16", "text": "Akşam görüntülü konuşalım mı Tontişim?", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tontişim"]}
{"id": "kisisel-ali-uzak-17", "text": "Havalimanındayım, uçak bir saat sonra.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-18", "text": "Meliş ay sonu Berlin'e geliyorum.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Meliş"]}
{"id": "kisisel-ali-uzak-19", "text": "Seni çok özledim, fotoğrafını gönderir misin?", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-20", "text": "Uçağım rötar yaptı yine, havayolu berbat.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-21", "text": "Tontişim iyi geceler, rüyanda beni gör.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tontişim"]}
{"id": "kisisel-ali-uzak-22", "text": "Akşam görüntülü konuşalım, sana bir şey göstereceğim.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-23", "text": "Berlin'deki ev arkadaşın nasıl?", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-24", "text": "Meliş biletleri aldım, on beşinde oradayım.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Meliş"]}
{"id": "kisisel-ali-uzak-25", "text": "Seni çok özledim, sayılı gün kaldı.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-26", "text": "Sabiha Gökçen'de güvenlikte sıra çok uzun.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-27", "text": "Tontişim bugün toplantın nasıl geçti?", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tontişim"]}
{"id": "kisisel-ali-uzak-28", "text": "Akşam görüntülü konuşalım mı, erken yatacağım.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-29", "text": "Uçağım rötar yaptı ama sonunda kalktık.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-30", "text": "Berlin'e indim, seni bekliyorum.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-31", "text": "Meliş seni görünce çok mutlu oldum.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Meliş"]}
{"id": "kisisel-ali-uzak-32", "text": "Seni çok özledim daha şimdiden.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-33", "text": "Tontişim dönüş biletine baktın mı?", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tontişim"]}
{"id": "kisisel-ali-uzak-34", "text": "Akşam görüntülü konuşalım, yolculuğu anlatırım.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-35", "text": "Berlin'den dönerken çikolata aldım.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-36", "text": "Sabiha Gökçen'e indim, annem beni almaya geldi.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-37", "text": "Meliş eve vardım, merak etme.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Meliş"]}
{"id": "kisisel-ali-uzak-38", "text": "Seni çok özledim, şimdiden gelmek istiyorum.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-39", "text": "Uçağım rötar yapmadı bu sefer, şaşırdım.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kisisel-ali-uzak-40", "text": "Tontişim akşam görüntülü konuşalım.", "category": "kisisel", "user": "ali-uzak", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0", "new_words": ["Tontişim"]}
