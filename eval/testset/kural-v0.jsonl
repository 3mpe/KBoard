{"id": "kural-tuzak-006", "text": "Eski evimizi özledim.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "eski", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-007", "text": "Sanki yıllardır tanışıyoruz.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "sanki", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-008", "text": "Saat birde buluşalım.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "birde: saat birde", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-009", "text": "Elimi yaktım, çok acıyor.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "elimi", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-010", "text": "Kolumu masaya çarptım.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "kolumu", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-011", "text": "O adamıydım ben, inanır mısın?", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "adamıydım: adamı + ydım", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-012", "text": "Bu benim kalemimdi, şimdi kayıp.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "kalemimdi", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-013", "text": "O da onun kalemiydi.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "kalemiydi: kalemi + ydi", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-014", "text": "Bu iş onun devamıdır.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "devamıdır", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-015", "text": "Toplantı resmiydi, takım elbise giydim.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "resmiydi", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-016", "text": "İşte bu da mevsimidir.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "mevsimidir", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-017", "text": "Ben de bir işadamıyım.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "işadamıyım", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-018", "text": "Odada kimse yok.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "odada", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-019", "text": "Oda çok sıcak, pencereyi aç.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "oda: başka okunuşta geçerli", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-020", "text": "Hala bekliyorum seni.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "hala", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-021", "text": "Halam bize geliyor.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "halam", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-022", "text": "Ambulans çağırın lütfen.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "ambulans: ambülans katlaması", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-023", "text": "Kusura bakma, geç kaldım.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "kusura: küsür katlaması", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-024", "text": "Fasulye pişirdim akşama.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "fasulye: fasülye katlaması", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-025", "text": "Yeni unvanı müdür oldu.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "unvan", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-026", "text": "Şoför yolu bilmiyordu.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "şoför", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-027", "text": "Her şey yolunda gidiyor.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "doğru ayrı yazım: her şey", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-028", "text": "Bir şey diyeceğim sana.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "doğru ayrı yazım: bir şey", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-029", "text": "Çay ya da kahve olur.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "doğru: ya da", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-030", "text": "Şu an evdeyim.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "doğru: şu an", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-031", "text": "Birçok kişi geldi.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "birçok: bitişik doğru", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-032", "text": "Hiçbiri gelmedi.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "hiçbiri", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-033", "text": "Herkes burada mı?", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "herkes", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-034", "text": "Herkesin bir derdi var.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "herkesin: herkez kökü değil", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-035", "text": "Herhalde gelir.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "herhalde", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-036", "text": "Bunu takdir ediyorum.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "takdir", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-037", "text": "Arkadaşına bir şey taktırmak istiyor.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "taktırmak: taktir kökü değil", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-038", "text": "Çarpışma, yani müsademe oldu.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "müsademe: müsade kökü değil", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-039", "text": "Bu tren nereye gidiyor?", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "tren", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-040", "text": "Halbuki ben söylemiştim.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "halbuki", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-041", "text": "Mademki geldin, otur.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "mademki", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-042", "text": "Oysaki her şey hazırdı.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "oysaki", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-043", "text": "Dünkü maçı izledin mi?", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "dünkü", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-044", "text": "Yarınki toplantı iptal.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "yarınki", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-045", "text": "Bizimkiler de geliyor.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "bizimkiler", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-046", "text": "Okulda görüşürüz.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "okulda", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-047", "text": "Kapıda biri var.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "kapıda", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-048", "text": "Hiç kimse bilmiyor.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "hiç kimse", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-049", "text": "Bilmem ki, sen karar ver.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "ki ayrı", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-050", "text": "Geliyor musun yarın?", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "doğru ayrı soru eki", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-051", "text": "Bunu yapabilir misin?", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "doğru ayrı soru eki", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-052", "text": "Şimdi mi geliyorsun?", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "şimdi mi", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-053", "text": "Annemi aradım.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "annemi: -mi ile biten", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-054", "text": "Seni gördüm mü dün?", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "gördüm mü", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-055", "text": "Eminim ki gelecek.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "eminim", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-056", "text": "Kimi zaman yalnız kalmak iyidir.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "kimi, yalnız", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-057", "text": "Tamam mı, anlaştık.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "tamam mı", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-058", "text": "Ekmek aldın mı?", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "aldın mı", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-059", "text": "Ben de geliyorum.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "ben de: doğru ayrı", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-tuzak-060", "text": "Yalnızca bir dakika bekle.", "category": "kural", "tags": ["kural", "kural_tuzak"], "note": "yalnızca", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-001", "text": "Ben de gelmek istiyorum.", "input": "Bende gelmek istiyorum.", "category": "kural", "tags": ["kural", "kural_dedaki"], "note": "bende → ben de (PR B)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-002", "text": "Sen de haklısın aslında.", "input": "Sende haklısın aslında.", "category": "kural", "tags": ["kural", "kural_dedaki"], "note": "sende → sen de (PR B)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-003", "text": "O da bilmiyor bu işi.", "input": "Oda bilmiyor bu işi.", "category": "kural", "tags": ["kural", "kural_dedaki"], "note": "oda → o da (PR B)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-004", "text": "Biz de katılırız o zaman.", "input": "Bizde katılırız o zaman.", "category": "kural", "tags": ["kural", "kural_dedaki"], "note": "bizde → biz de (PR B)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-005", "text": "Annem de geldi bugün.", "input": "Annemde geldi bugün.", "category": "kural", "tags": ["kural", "kural_dedaki"], "note": "annemde → annem de (PR B)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-006", "text": "Dedim ki yarın gel.", "input": "Dedimki yarın gel.", "category": "kural", "tags": ["kural", "kural_dedaki"], "note": "dedimki → dedim ki (PR B)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-007", "text": "Biliyorum ki zor olacak.", "input": "Biliyorumki zor olacak.", "category": "kural", "tags": ["kural", "kural_dedaki"], "note": "biliyorumki → biliyorum ki (PR B)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-008", "text": "Bu akşam bizde kalabilirsin.", "category": "kural", "tags": ["kural", "kural_dedaki", "kural_tuzak"], "note": "bizde: hâl eki, doğru (PR B tuzağı)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-009", "text": "Kitap sende mi?", "category": "kural", "tags": ["kural", "kural_dedaki", "kural_tuzak"], "note": "sende: hâl eki, doğru (PR B tuzağı)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-010", "text": "Kardeşim de gelecek yarın.", "input": "Kardeşimde gelecek yarın.", "category": "kural", "tags": ["kural", "kural_dedaki"], "note": "kardeşimde → kardeşim de (PR B)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-011", "text": "Onlar da bizimle gelsin.", "input": "Onlarda bizimle gelsin.", "category": "kural", "tags": ["kural", "kural_dedaki"], "note": "onlarda → onlar da (PR B)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-012", "text": "Ben onlarda kaldım iki gün.", "category": "kural", "tags": ["kural", "kural_dedaki", "kural_tuzak"], "note": "onlarda: hâl eki, doğru (PR B tuzağı)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
{"id": "kural-dedaki-013", "text": "Kimseye söyleme, aramızda kalsın.", "category": "kural", "tags": ["kural", "kural_dedaki", "kural_tuzak"], "note": "aramızda: doğru (PR B tuzağı)", "source": "sentetik: yapay zekâ ile üretildi (Claude), insan gözden geçirmedi", "license": "CC0-1.0"}
