{"id": "taze-dogal-001", "text": "Acaba Beria bunların farkında mıydı?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-002", "text": "Adeta ellerim titreyerek katalogu karıştırdım.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-003", "text": "Akdeniz seferine çıkan gemilerin tayfaları uğradıkları limanlardan ucuz ucuz portakal alır getirirlerdi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-004", "text": "Akşamki hislerinden ancak büyük bir korku kalmıştı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-005", "text": "Alacakaranlıkta köyden çıkarak ormana doğru yürüdüler.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-006", "text": "Alışmış, kudurmuştan beterdir!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-007", "text": "Ama adam ellisinden sonra rakıya vurdu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-008", "text": "Ama sen değilsin.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-009", "text": "Aman oğlum o namluyu çevir.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-010", "text": "Anana acımıyor musun?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-011", "text": "Annen için üzüldüm.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-012", "text": "Aralık duran bahçe kapısını ayağıyla itti.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-013", "text": "Aslan kükrerse atın ayağı kösteklenir.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-014", "text": "Atalar çıkarayım der tahta, döner dolanır gelir bahta.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-015", "text": "Ayranım ekşidir diyen olmaz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-016", "text": "Ağaçtan maşa, aptaldan paşa olmaz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-017", "text": "Ağlama, onun ruhunu güldürmek istersen bana sarıl!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-018", "text": "Ağılda oğlak doğsa, dere boyunda otu biter.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-019", "text": "Baba oğul oldukları ilk bakışta anlaşılacak kadar birbirlerine benziyorlardı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-020", "text": "Baht olmayınca başa, ne kuruda biter ne de yaşta.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-021", "text": "Bak bana bir gözle, bakayım sana iki gözle.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-022", "text": "Bakalım ne yapabilirim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-023", "text": "Bana bak Yusuf, dedim, insan hali işte böyle.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-024", "text": "Bana benden olur her ne olursa, başım rahat eder dilim durursa", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-025", "text": "Bana da ver.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-026", "text": "Bana elini ver.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-027", "text": "Bana hakikaten yaşamak imkânını verdiğin birkaç ay için sana teşekkür ederim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-028", "text": "Bana karşı, nazik, fakat daima arada bir boşluk bırakan tavrını muhafaza etti.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-029", "text": "Bana ne oldu?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-030", "text": "Bana niye öyle bakıyorsun?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-031", "text": "Bayıra tırmanmaya başlayınca otuz sene evvel geçtiğim yolu çok güzel hatırladım.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-032", "text": "Bekle bir dakika!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-033", "text": "Belki de haklıdır.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-034", "text": "Ben Bu akşam sizinle dans etmeyeceğim Nurullah bey.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-035", "text": "Ben burada ayrılayım.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-036", "text": "Ben de bu hususta bir şey sormaktan çekiniyordum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-037", "text": "Ben de yanına iliştim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-038", "text": "Ben de yaşayacağım.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-039", "text": "Ben doymadım, bana sucuk kızartıver!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-040", "text": "Ben evlenmedim, kısmet değilmiş.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-041", "text": "Ben sizinle nasıl açıkça konuştumsa siz de bana içinizi dökebilirsiniz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-042", "text": "Beni affeder misin?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-043", "text": "Benimle eğleniyorsun, ben artık çocuk değilim!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-044", "text": "Benimle ilgisi yok.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-045", "text": "Berber on iki gün yaşadı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-046", "text": "Bilgi Yönetimi ve Mevcut Durum Analizi", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-047", "text": "Bir anlamı yok.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-048", "text": "Bir daha da gözlerini kapamadı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-049", "text": "Bir dakikaya geliyorum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-050", "text": "Bir evde düzen varsa düzen olmaz o evde.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-051", "text": "Bir ricam var.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-052", "text": "Bir sabah, bizim koruya baltacıların girdiği haberi köyü dolaştı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-053", "text": "Bir saniye, bir saniye.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-054", "text": "Bir soru daha.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-055", "text": "Bir türlü çekilip gidemiyordum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-056", "text": "Bir yere mi gidiyorsun?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-057", "text": "Bir zararı olmaz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-058", "text": "Bir şey demedi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-059", "text": "Bir şeyler ters gidiyor.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-060", "text": "Biraz alabilir miyim?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-061", "text": "Biraz böyle durdu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-062", "text": "Biraz zaman alacak.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-063", "text": "Biri beni kurtarsın!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-064", "text": "Bizi dışarı atacak olan deliğe yarım adım bile yoktu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-065", "text": "Borç iyi güne kalmaz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-066", "text": "Bu adres üzerinde alt yapı yok", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-067", "text": "Bu akşam da aynı yerden geçeceğimi nasıl tahmin ettiniz?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-068", "text": "Bu bakışı biliyorum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-069", "text": "Bu bir kural.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-070", "text": "Bu bir yönüyle yeni bir durum tazminidir de.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-071", "text": "Bu da birinci hüküm kadar doğru.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-072", "text": "Bu gecenin hadiseleri, onlara hatıralarımla bile dokunmaktan ürkecek kadar kıymetliydiler.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-073", "text": "Bu gülüşlerin arkasında bir şey saklı gibiydi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-074", "text": "Bu hayat değil.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-075", "text": "Bu hayatı anlayamadım.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-076", "text": "Bu konuyu kapatabilir miyiz?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-077", "text": "Bu ne hoş bir sürpriz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-078", "text": "Bu ne için?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-079", "text": "Bu numaraya gönderebilirsiniz efendim", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-080", "text": "Bu oğlandan gayrı sana hayır gelmeyeceğini anladın.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-081", "text": "Bu son olacak.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-082", "text": "Bu sırada gazinocu geldi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-083", "text": "Bu tarafa geliyorlar.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-084", "text": "Bugün biraz iyiyim!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-085", "text": "Buna mukabil alacağı on kuruşla eve bir kara ekmek götürebilirdi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-086", "text": "Buna vakit yok.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-087", "text": "Bunlarla olan münasebetim beni tatmin etmese bile hiç olmazsa sinirlendirmiyor.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-088", "text": "Bunların anaları da var değil mi?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-089", "text": "Bunu ben de yapabilirim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-090", "text": "Bunu kendine yapma.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-091", "text": "Bunun iyi bir fikir olduğundan emin değilim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-092", "text": "Buralardan değilsin, değil mi?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-093", "text": "Buraya geleceğini biliyordum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-094", "text": "Buraya getirip oturttukları mübadillerin de kabahati yoktu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-095", "text": "Bütün ihtiyatına rağmen onun yüzüne çarpan bir kılıcı siyah örtüsünü düşürdü.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-096", "text": "Büyük bir kıskançlıkla herkesten sakladığınız planınızı bugün söyleyeceksiniz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-097", "text": "Büyüleyici, değil mi?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-098", "text": "Bırak onu gitsin!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-099", "text": "Canın yanıyor mu?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-100", "text": "Daha doğrusu bunu istemedim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-101", "text": "Daha mutlu olamazdım.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-102", "text": "Dargın ayrılmak istememişti.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-103", "text": "Dava edersen ne kazanacaksın?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-104", "text": "Derhal kendini feda ediyorsun, değil mi?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-105", "text": "Derhal koşarak Kürk Mantolu Madonna'ya yetişmek istedim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-106", "text": "Dertsiz baş terkide gerek.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-107", "text": "Değil mi Hatice, hiç üzülmeyeyim, hiç korkmayayım değil mi?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-108", "text": "Dost bin ise azdır, düşman bir ise çoktur.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-109", "text": "Dört katlı otelin en üst penceresinden beyaz bir gölge sarkıyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-110", "text": "Dün akşamdan beri birbirini kovalayan hadiselerin ağırlığını ancak şimdi ve tamamen duyuyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-111", "text": "Dünya bol olmuş neye yarar, pabuç dar olduktan sonra.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-112", "text": "Dünya tükenir, yalan tükenmez.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-113", "text": "Düş uykudan sonra olur.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-114", "text": "Düşüncelerini mümkün olduğu kadar Ömer’den uzak tutmak istiyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-115", "text": "Efe on iki dilaver arkadaşıyla kaçmıyor, bekliyor, aslan gibi bekliyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-116", "text": "Eliyle yaptığı işaret ile onu çağırdı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-117", "text": "Eliyle yüzündeki yağmur tanelerini sildi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-118", "text": "Emir kati idi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-119", "text": "En ufak bir fikrim yok.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-120", "text": "Enfes bir şey doğrusu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-121", "text": "Erken geldik galiba!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-122", "text": "Eve mi gidiyorsun?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-123", "text": "Evet, aslında öyle.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-124", "text": "Evet, aşağı yukarı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-125", "text": "Evlenenle ev alana Allah yardım eder.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-126", "text": "Fakat bir müddet sonra garip bir hisle kendine geldi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-127", "text": "Fikirlerim birdenbire değişmişti.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-128", "text": "Galiba gideceği yeri düşünmekle meşgul de, nereden geldiğinin pek farkında değil.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-129", "text": "Garip olan ne?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-130", "text": "Gelin alan kaymak alır bal alır.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-131", "text": "Gelinin köyüne oynaya oynaya girmek lazımdı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-132", "text": "Gelmek ister misin?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-133", "text": "Gözlerinin esmerleşen kenarlarında, beyaz dudaklarında ölümün tayf halinde dolaştığını genç erkek görüyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-134", "text": "Güzel kadınlara karşı şimdiye kadar duyduğum şeyleri bu kızcağıza karşı duymadım.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-135", "text": "Hadi eve gidelim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-136", "text": "Hanım kırarsa kaza, halayık kırarsa ceza.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-137", "text": "Harika bir parti.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-138", "text": "Hastanenin bodrum katındaki küçük ve pencereleri demir parmaklıklı odada beş kişi yatıyorduk.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-139", "text": "Hatta birkaç yerde onun sözünü keserek izah ettirdi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-140", "text": "Hatta Ömer bile söyleyecek söz bulamıyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-141", "text": "Hayır, bir saniye.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-142", "text": "Hele bu sefer, evvelden gelen bir his onu herhalde içeride bulacağımı söyledi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-143", "text": "Hele ormandan çıktıkları zaman güneş bile görünmeye başlamıştı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-144", "text": "Hemen ahbap oluverdiler.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-145", "text": "Henüz bir şey yok.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-146", "text": "Her gün birkaç kere yanına geliyorlar.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-147", "text": "Her zaman vardır.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-148", "text": "Her şey hazır.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-149", "text": "Herhalde fasıl arası olacaktı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-150", "text": "Herif, müfettişler Hamburg usulü bilmezler diye defterleri Hamburg usulü tutuyor.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-151", "text": "Herifin kaybı ile kendi kazancını mukayese et!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-152", "text": "Herkesin delisi evinde, derdi karnında.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-153", "text": "Hesabı alabilir miyim?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-154", "text": "Hiç bir şey yapmadım.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-155", "text": "Hiç de fena insanlar değillerdi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-156", "text": "Hiç zor değil.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-157", "text": "Hiçbir şey istemiyor, yalnız onu görebilmek, onun sesini işitebilmek arzusunu duyuyordum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-158", "text": "Hiçbir şey olmadı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-159", "text": "Kafam derhal birtakım teselliler bulmaya bile başlamıştı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-160", "text": "Kafamda ona bir hayat seyri icap edip yanında yürüyeceğim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-161", "text": "Kanaat gibi devlet olmaz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-162", "text": "Kapının önü tenhaydı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-163", "text": "Kapıya doğru yaklaştıkça adımlarını hızlandırdı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-164", "text": "Kar susuzluk kandırmaz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-165", "text": "Kayalar arasındaki dik ve dar bir patikadan inince Kızılkeçili Deresi'yle karşılaştık.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-166", "text": "Kendimi zelzele esnasında bir mabette zannediyordum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-167", "text": "Kendini nasıl savunacaksın?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-168", "text": "Kim yapmış bunu?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-169", "text": "Kim, ben mi?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-170", "text": "Köylüyü müdafaa etmedim mi?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-171", "text": "Küçük dimağı bir türlü bunu tayin edemiyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-172", "text": "Laf olsun diye söylemiştim...", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-173", "text": "Lâkin gafil genç bunu bilmiyor, onun, çalgısını kendisi kadar çok sevmesini kıskanıyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-174", "text": "Lütfen kabul et.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-175", "text": "Macide arkadaşlarından ayrılıp eve dönünce derhal odasına çıktı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-176", "text": "Macide kafasına doğru bir şeylerin yükseldiğini hissetti.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-177", "text": "Macide omuzlarını silkti.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-178", "text": "Maksatları yalnız sizdiniz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-179", "text": "Merak etme sen.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-180", "text": "Muntazam kaldırımlı tertemiz sokaklarında, bizi misafir eden yüzbaşının kızları ve mahallenin erkekleri.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-181", "text": "Mütehassıs daha birkaç gün kalmasını istiyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-182", "text": "Mütemadiyen sallanmakta ve çatlak, kuru yumruklarını ağzına ve gözlerine götürmekte idi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-183", "text": "Nasıl bilebilirim ki?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-184", "text": "Nasıl olmuş da ayrılırken bunu düşünmemiştik?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-185", "text": "Ne dedim ben size?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-186", "text": "Ne gelir elden delikanlı?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-187", "text": "Ne haber dostum?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-188", "text": "Ne kadar kaldığını kendim de bilmiyor, sadece zavallıya biraz gayret vermek istiyordum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-189", "text": "Ne kadar kazandın?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-190", "text": "Ne o, gözlerini kapadın, hala fena mısın?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-191", "text": "Ne oldu bize?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-192", "text": "Ne yapmam gerektiğini söyle.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-193", "text": "Ne yaptılar sana?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-194", "text": "Ne yaptın ona?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-195", "text": "Neden böyle diyorsun?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-196", "text": "Neden öyle düşünüyorsun?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-197", "text": "Nihayet bizim de yardımımızla makine yokuşun başını buldu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-198", "text": "Niçin kendisine hakim olamamıştı, niçin böyle münasebetsiz laflar söylemişti?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-199", "text": "O harika bir çocuk.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-200", "text": "O kendisini kapı dışarı edince de umumhaneye düştü.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-201", "text": "Odanın iki duvarındaki ufak pencerelerin önünde kalabalık vardı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-202", "text": "Oh, önemli değil.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-203", "text": "Omuzundan bal teknesini indirip bir gömeç almış, Hasan'a vermiş.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-204", "text": "Ona bir şans ver.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-205", "text": "Ona yardım etmeliyim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-206", "text": "Onlara ihtiyacımız var.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-207", "text": "Onları kurtaracak birisi herhalde çıkacaktır.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-208", "text": "Onu görebildin mi?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-209", "text": "Onu kandırmaya imkan yoktu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-210", "text": "Onun ağlamaklı yüzünü görür gibi oldu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-211", "text": "Onun beni, yattığı yerden göz ucuyla takip ettiğini sezmiştim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-212", "text": "Onun için seninle biraz görüşmek istedim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-213", "text": "Onun işi bu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-214", "text": "Onun ruhunun kendisinin bile farkına varmadığı derinliklerine süzüleceğimden eminim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-215", "text": "Orada kır hayatı sıhhatim için herhalde iyidir.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-216", "text": "Papaz her gün pilav yemez.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-217", "text": "Parmaklarına dikkat et.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-218", "text": "Peki ne öneriyorsun?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-219", "text": "Peki ya diğerleri?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-220", "text": "Pencereleri krem renginde tül perdeler kapatıyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-221", "text": "Sadece bir sorum var.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-222", "text": "Sakin olmaya çalışın.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-223", "text": "Sana birşey söylemeliyim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-224", "text": "Sana göz kulak olacağım.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-225", "text": "Sana ne kadar teşekkür etsem az.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-226", "text": "Sana yardım etmeye çalışıyoruz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-227", "text": "Sanki akşamdan beri gördükleri ve hissettikleri şeyler omuzlarına çökmüş onları eziyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-228", "text": "Sanki her şey onu bir tarafından çekip alıkoymaya çalışıyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-229", "text": "Saraya gündüzden mi geldiniz?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-230", "text": "Sağ ayağını altına almış ve şapkasını yanına koymuştu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-231", "text": "Sen bir avukatsın.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-232", "text": "Sen bir yetişkinsin.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-233", "text": "Sen de güzelsin.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-234", "text": "Seni eve götüreceğiz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-235", "text": "Seni kaybettiğimi sanmıştım.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-236", "text": "Seni tekrar gördüğüme sevindim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-237", "text": "Senin de yok.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-238", "text": "Seninle bir anlaşma yapalım.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-239", "text": "Sesini duymak istiyorum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-240", "text": "Siz harikulade bir kadınsınız!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-241", "text": "Siz nerede kaldınız?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-242", "text": "Sizin suçunuz değil.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-243", "text": "Son defa yavrularını, şimdiye kadar anlayamadığı bir his ile bütün kuvvetiyle sıktı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-244", "text": "Sonra kalktım, biraz evvel hazırladığım paketi kolumun altına sıkıştırdım, dışarı çıktım.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-245", "text": "Sorunun ne senin?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-246", "text": "Söylediklerini tekit etmek isteyen dudaklar birleşti.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-247", "text": "Sözlerim geceyi çınlattı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-248", "text": "Tabi ki hayır.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-249", "text": "Tahta basamakları çıkarken bütün bahçede müthiş bir alkış koptu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-250", "text": "Tam olarak nerede?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-251", "text": "Tamam, bir saniye.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-252", "text": "Tamam, yeter artık!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-253", "text": "Tanışmak için sabırsızlanıyorum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-254", "text": "Tekrar hoş geldin.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-255", "text": "Ucuzdur vardır illeti, pahalıdır vardır hikmeti.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-256", "text": "Uzun bir süre.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-257", "text": "Vagon küçük Hasan'dan beş altı adım uzaklaşmıştı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-258", "text": "Vaka Miladi yedinci asırda ve Çin'in payitahtlarından birinde geçer.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-259", "text": "Varını veren utanmamış.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-260", "text": "Vaziyet benim için çok azaplı idi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-261", "text": "Ve memleketin kadınları onun şiirlerini sonsuz bir baygınlık ve şehvetle okurlardı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-262", "text": "Ve mülksüzlük iyidir, göç yolunda ağırlık yapmaz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-263", "text": "Ve niçin o, ince parmaklarını yüzümde gezdirerek bana, yalnız bana inandığını söyleyemiyordu?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-264", "text": "Ve onu ancak, kolumuzu kımıldatamayacak kadar bize hakim olduğu zaman kabul ediyoruz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-265", "text": "Veda etmek istiyorum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-266", "text": "Yaptıklarımı mazur görmeyi ne kadar istediği yüzünden okunuyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-267", "text": "Yardım edecek misin, etmeyecek misin?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-268", "text": "Yarın görüşecek miyiz?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-269", "text": "Yarın okulda uzun uzun konuşuruz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-270", "text": "Yelkenler artık kullanılmaz bir haldeydi, direklerden bile korkulurdu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-271", "text": "Yol parası vereceklerin arasında muhtar beni de okudu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-272", "text": "Yolda beş on adım gittikten sonra bir araba geçti.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-273", "text": "Yüzünde pek manalı bir tebessüm vardı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-274", "text": "Çanakta balın olsun, Yemen'den arı gelir.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-275", "text": "Çay ister misin?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-276", "text": "Çok aradınız mı?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-277", "text": "Çok hoşuma gitti.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-278", "text": "Çok iyi, çok iyi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-279", "text": "Çok yardımcı oldunuz.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-280", "text": "Çünkü ben daima ilk görüşte aşık olurum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-281", "text": "Çünkü gerçek bu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-282", "text": "Öldü mü ki ne, Hacer kadın?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-283", "text": "Ömer devam edecek diye karşısındakinin yüzüne bakıyordu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-284", "text": "Örtük pazar ara bozar.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-285", "text": "Ötekini arzu etmek münasebetsizdir.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-286", "text": "Özrün kabul edildi.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-287", "text": "Üç Mart bin dokuz yüz kırk dört.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-288", "text": "Üç tane de çocuğu oldu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-289", "text": "İbrahim'in para bulup getirebileceğinden de ümidini kesmeye başlamıştı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-290", "text": "İki milyon ha!", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-291", "text": "İkisi de işe gidiyorlar.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-292", "text": "İmparator arkadan gelir.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-293", "text": "İyi günler efendim.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-294", "text": "İçinde köpürüp taşan bir saadet vardı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-295", "text": "İşte burada halk adi, alelade ve çürük ruhluydu.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-296", "text": "İşte tam burada.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-297", "text": "Şimdi ne halt edeceğiz?", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-298", "text": "Şimdi ondan ayrılmak ve haftalarca görmemek mümkündü.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-299", "text": "Şimdi onun niçin benden evvel seyahate çıktığını da anlar gibi oluyordum.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
{"id": "taze-dogal-300", "text": "Şu nikâh işi bitse belki biraz daha kolaylaşacaktı.", "category": "dogal", "source": "commonvoice-tr", "license": "CC0-1.0"}
