<!-- KBOARD: kişisel öğrenme deposu (files/kboard/personal-tr.bin) bulut yedeğine ve cihazdan cihaza
     aktarıma girmez (API 31+). Yalnız dışlama: geri kalan her şey önceki gibi. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="kboard" />
        <exclude domain="device_file" path="kboard" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="kboard" />
        <exclude domain="device_file" path="kboard" />
    </device-transfer>
</data-extraction-rules>
